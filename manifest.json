
{
  "manifest_version": 3,
  "name": "MyPeugeot OAuth Capture",
  "version": "1.0",
  "description": "Récupération locale du code OAuth MyPeugeot",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://idpcvs.peugeot.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MyPeugeot OAuth",
    "default_popup": "popup.html"
  }
}
