{
  "manifest_version": 3,
  "name": "MyPeugeot OAuth Capture",
  "version": "1.1.0",
  "description": "Récupération locale du code OAuth MyPeugeot",
  "permissions": [
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://idpcvs.peugeot.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "MyPeugeot OAuth",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mypeugeot-oauth-capture@lhplab.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
